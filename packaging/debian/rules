#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- -G Ninja -DCMAKE_BUILD_TYPE=Release -DCUI_PLATFORM=glfw

override_dh_auto_build:
	dh_auto_build --parallel

override_dh_auto_install:
	install -d $(CURDIR)/debian/cuiviewer/usr/bin
	install -m755 $(CURDIR)/build/cuiviewer $(CURDIR)/debian/cuiviewer/usr/bin/cuiviewer
	install -d $(CURDIR)/debian/cuiviewer/usr/share/doc/cuiviewer
	install -m644 $(CURDIR)/README.md $(CURDIR)/debian/cuiviewer/usr/share/doc/cuiviewer/README.md
	install -d $(CURDIR)/debian/cuiviewer/usr/share/applications
	printf '[Desktop Entry]\nName=cuiviewer\nComment=Native image viewer\nExec=cuiviewer\nType=Application\nCategories=Graphics;Viewer;\n' > $(CURDIR)/debian/cuiviewer/usr/share/applications/cuiviewer.desktop
